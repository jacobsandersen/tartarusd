[Unit]
Description=Razer Tartarus V2 remapping daemon
Documentation=https://github.com/jacobsandersen/tartarusd
# OpenRazer is required: LEDs go through its D-Bus API.
Wants=openrazer-daemon.service
After=openrazer-daemon.service
# Start with the graphical session, after the compositor is up and has exported its
# environment: window-based auto-switching detects the compositor once, at startup.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/tartarusd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
